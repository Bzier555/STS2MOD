<Project>
  <!-- Machine-specific paths belong in this ignored file. -->
  <Import Project="Directory.Build.local.props"
          Condition="Exists('Directory.Build.local.props')" />

  <!--
    Sts2PathDiscovery.props normally finds Steam automatically. Publishing also
    requires GodotPath to point to MegaDot 4.5.1 (or exactly matching Godot .NET).
    See Directory.Build.local.props.example.
  -->
</Project>
