<Project Sdk="Microsoft.NET.Sdk">
  <Import Project=".\Sts2PathDiscovery.props" />

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RotatingDecks</AssemblyName>
    <RootNamespace>RotatingDecks</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;MSB3270</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(Sts2DataDir)')">
    <Reference Include="0Harmony">
      <HintPath>$(Sts2DataDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="sts2">
      <HintPath>$(Sts2DataDir)\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BaseLib">
      <HintPath>$(ModsPath)BaseLib\BaseLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="RotatingDecks.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CheckDependencyPaths" BeforeTargets="ResolveReferences">
    <Error Text="Slay the Spire 2 data was not found at '$(Sts2DataDir)'. Set Sts2Path on the command line if the game is installed elsewhere."
           Condition="'$(Sts2DataDir)' == '' or !Exists('$(Sts2DataDir)')" />
    <Error Text="BaseLib.dll was not found at '$(ModsPath)BaseLib\BaseLib.dll'. Install BaseLib 3.4.5 or newer before building."
           Condition="!Exists('$(ModsPath)BaseLib\BaseLib.dll')" />
  </Target>
</Project>
